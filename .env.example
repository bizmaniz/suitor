# Suitor optional environment overrides
# Most users should run npm run setup and leave this file alone.

# Core
# SUITOR_CONFIG_DIR=
# SUITOR_PROFILE_ROOT=
# SUITOR_RUNTIME_ROOT=
# SUITOR_ASSESSMENTS_ROOT=
# SUITOR_HOST=127.0.0.1
# SUITOR_PORT=8787
# SUITOR_PERSON_KEY=local
# SUITOR_ALLOW_LAN=0
# SUITOR_ALLOWED_HOSTS=
# SUITOR_AUTH_FAILURE_LIMIT=5
# SUITOR_AUTH_FAILURE_WINDOW_MS=300000

# Assistant and LLM
# SUITOR_LLM_PROVIDER=openai
# SUITOR_ASSISTANT_NAME=Scout
# SUITOR_CODEX_BIN=
# SUITOR_CLAUDE_BIN=
# SUITOR_CLAUDE_PERMISSION_MODE=default

# Candidate summary overrides
# SUITOR_CANDIDATE_NAME=
# SUITOR_CANDIDATE_FIRST=
# SUITOR_CANDIDATE_INITIALS=
# SUITOR_LOCKED_TARGET=
# SUITOR_LOCATION_SUMMARY=
# SUITOR_COMP_SUMMARY=
# SUITOR_COMP_DETAIL=
# SUITOR_COMP_FLOOR=
# SUITOR_RELOCATION_COMP_FLOOR=

# Scanning
# SUITOR_SKIP_WEBSEARCH=1
# SUITOR_WEBSEARCH_DELAY_MS=750
# SUITOR_VERIFIED_SCAN_LIMIT=50
# SUITOR_VERIFY_FETCH_CONCURRENCY=4

# LinkedIn browser scan
# SUITOR_LINKEDIN_QUERY=
# SUITOR_LINKEDIN_LOCATION=United States
# SUITOR_LINKEDIN_WORKPLACE=2
# SUITOR_LINKEDIN_EXPERIENCE=
# SUITOR_LINKEDIN_RECENCY=r604800
# SUITOR_LINKEDIN_LIMIT=10
# SUITOR_LINKEDIN_INSPECT_LIMIT=25

# Optional Adzuna provider
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
